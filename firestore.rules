rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny read/write by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /subscribers/{userId} {
      // Clients cannot read ALL documents, but can read their own
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      
      // Allow create/update/delete only for the authenticated user's own document
      // Note: allow write is a combination of create, update, and delete.
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && isValidSubscriber(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    function isValidPreferences(prefs) {
      return prefs == null || (
        prefs is map
        && prefs.keys().hasOnly([
          'criticalAlerts', 'highSeverityAlerts', 'officialAdvisories', 
          'dataBreaches', 'threatIntelligence', 'aiTechUpdates', 'generalNews'
        ])
        && (!('criticalAlerts' in prefs) || prefs.criticalAlerts is bool)
        && (!('highSeverityAlerts' in prefs) || prefs.highSeverityAlerts is bool)
        && (!('officialAdvisories' in prefs) || prefs.officialAdvisories is bool)
        && (!('dataBreaches' in prefs) || prefs.dataBreaches is bool)
        && (!('threatIntelligence' in prefs) || prefs.threatIntelligence is bool)
        && (!('aiTechUpdates' in prefs) || prefs.aiTechUpdates is bool)
        && (!('generalNews' in prefs) || prefs.generalNews is bool)
      );
    }

    function isValidSubscriber(data) {
      return data.keys().hasOnly(['fcmToken', 'enabled', 'preferences', 'createdAt', 'updatedAt'])
        && data.fcmToken is string
        && data.enabled is bool
        && isValidPreferences(data.preferences)
        && data.createdAt is string
        && data.updatedAt is string;
    }
  }
}
